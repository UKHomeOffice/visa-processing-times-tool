{
  "name": "visa-processing-times-tool",
  "version": "1.0.0",
  "description": "Tool to calculate the expected reply to a visa application according to SLA",
  "main": "index.js",
  "engines": {
    "node": ">=24.22.2 <25.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "hof-build watch --env",
    "build": "hof-build",
    "postinstall": "hof-build",
    "test": "NODE_ENV=test yarn run test:lint && yarn run test:unit",
    "test:lint": "eslint . --config ./node_modules/eslint-config-hof/default.js",
    "test:unit": "jest --verbose --testPathPatterns=test/unit --passWithNoTests",
    "bddgen": "bddgen",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:headed": "bddgen && playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UKHomeOffice/visa-processing-times-tool.git"
  },
  "author": "HOF",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/UKHomeOffice/visa-processing-times-tool/issues"
  },
  "homepage": "https://github.com/UKHomeOffice/visa-processing-times-tool/",
  "dependencies": {
    "accessible-autocomplete": "^3.0.2",
    "bl": "^7.0.14",
    "busboy": "^1.6.0",
    "hof": "~24.7.1",
    "jquery": "^4.0.0",
    "lodash": "^4.18.1",
    "moment": "^2.31.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.1.1",
    "dotenv": "^18.0.9",
    "eslint": "^8.57.1",
    "eslint-config-hof": "^1.3.4",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "playwright": "1.64.1",
    "playwright-bdd": "^9.2.1"
  }
}
